/*!
 * vidrank telemetry-sdk（v5 §3.8 要素 1，阶段一 · 单文件 IIFE，无构建）
 *
 * 体积口径：未压缩 ≤15KB，gzip 后 ≤5KB。
 * 唯一上报 API：Telemetry.track(event, payload)；page_view 自动上报（load + SPA history）。
 *
 * 用法：
 *   Telemetry.init({
 *     siteId: 'audiogram-gen',                                  // 必填
 *     endpoint: 'https://api.guomeijiayu.com/audiogram-gen/track',  // 必填，完整 URL（含 origin，SDK 不拼前缀）
 *     manifestUrl: 'https://api.guomeijiayu.com/manifests/audiogram-gen.json', // 可选，加载失败不阻断上报
 *     consent: false,                                           // 初始 consent（未决策时先缓冲）
 *     production: true                                          // 正式站点显式启用；localhost 可用于同源联调
 *   });
 *
 * 后端是权威清洗方：生产模式 SDK 不校验字段、全部上报；开发期（localhost 或 ?debug）
 * 仅 console.assert 反馈，不阻断发送。granted 使用顶层信封；denied 只发 {event,total} 匿名聚合行。
 */
(function (global) {
  'use strict';

  var MAX_BATCH_EVENTS = 50;
  var MAX_BATCH_BYTES = 32 * 1024;
  var MAX_SINGLE_EVENT_BYTES = 32 * 1024;
  var MAX_QUEUE = 200;
  var MAX_RETRIES = 3;

  /* 同意决策事实事件（法务征询函 v3.1 §4）：恒走最小行即时发送，不进队列/缓冲 */
  var DECISION_EVENTS = { consent_changed: 1, consent_updated: 1, consent_responded: 1, consent_withdrawn: 1 };

  var state = {
    siteId: '',
    endpoint: '',
    manifest: null,
    consent: false,
    consentMode: 'unset', // granted | denied | unset（v4.2 A1+1b 三态门控）
    production: false,
    deniedCounts: {},
    queue: [],
    sending: false,
    droppedCount: 0,       // 队列超限丢最旧的计数
    oversizeCount: 0,      // 单事件超 32KB 单独发送失败的计数
    retryCount: 0,
    lastPagePath: null,
    inited: false
  };

  // ---------- 工具 ----------

  function isDebug() {
    try {
      var host = global.location ? global.location.hostname : '';
      if (host === 'localhost' || host === '127.0.0.1' || /[?&]debug/.test(global.location.search)) {
        return true;
      }
    } catch (e) { /* noop */ }
    return false;
  }

  function uuid32() {
    var hex = '0123456789abcdef';
    var out = '';
    var buf = new Uint8Array(16);
    (global.crypto || {}).getRandomValues ? global.crypto.getRandomValues(buf)
      : (function () { for (var i = 0; i < 16; i++) { buf[i] = Math.floor(Math.random() * 256); } })();
    for (var i = 0; i < 16; i++) {
      out += hex[buf[i] >> 4] + hex[buf[i] & 15];
    }
    // RFC 4122 版本/变体位（保持 32 位小写 hex、无连字符）
    out = out.substring(0, 12) + '4' + out.substring(13, 16) + hex[(parseInt(out[16], 16) & 3) | 8] + out.substring(17);
    return out;
  }

  /** v5 §3.2 值规范：page_path 以 / 开头、去尾斜杠（根除外）、小写、剥离 query */
  function normalizePagePath(path) {
    if (!path) { return '/'; }
    var p = String(path).split('?')[0].split('#')[0];
    if (p.charAt(0) !== '/') { p = '/' + p; }
    p = p.toLowerCase();
    if (p.length > 1) {
      p = p.replace(/\/+$/, '');
      if (p === '') { p = '/'; }
    }
    return p.substring(0, 512);
  }

  /** v5 §3.2 值规范：referrer_host 仅主机名、小写、去 www.、直连 direct */
  function normalizeReferrerHost(ref) {
    if (!ref) { return 'direct'; }
    var a = document.createElement('a');
    a.href = ref;
    var host = (a.hostname || '').toLowerCase();
    if (!host) { return 'direct'; }
    if (host.indexOf('www.') === 0) { host = host.substring(4); }
    return host.substring(0, 128) || 'direct';
  }

  /** v5 §3.2 值规范：device_type ∈ desktop|mobile|tablet（UA 判定） */
  function detectDeviceType(ua) {
    ua = ua || '';
    if (/iPad|Tablet|PlayBook|Silk/i.test(ua) || (/Android/i.test(ua) && !/Mobile/i.test(ua))) {
      return 'tablet';
    }
    if (/Mobi|iPhone|iPod|Android.*Mobile|Windows Phone/i.test(ua)) {
      return 'mobile';
    }
    return 'desktop';
  }

  /** sess_ref：{site_id}:{uuid32}，会话内持久（sessionStorage） */
  function getSessRef(siteId) {
    var key = 'vidrank_sess_ref';
    try {
      var v = global.sessionStorage ? global.sessionStorage.getItem(key) : null;
      if (v && v.indexOf(siteId + ':') === 0) { return v; }
      var fresh = siteId + ':' + uuid32();
      if (global.sessionStorage) { global.sessionStorage.setItem(key, fresh); }
      return fresh;
    } catch (e) {
      return siteId + ':' + uuid32(); // storage 不可用（隐私模式）：会话内变量级，退化为每页一次
    }
  }

  // ---------- A1 未决策缓冲（sessionStorage 会话级；同意后回放，拒绝/关标签页即清） ----------

  var BUFFER_KEY = 'vidrank_tm_buffer';

  function persistBuffer() {
    if (state.consentMode !== 'unset') { return; }
    try { if (global.sessionStorage) { global.sessionStorage.setItem(BUFFER_KEY, JSON.stringify(state.queue)); } } catch (e) { /* noop */ }
  }

  function restoreBuffer() {
    if (state.consentMode !== 'unset') { return; }
    try {
      var raw = global.sessionStorage ? global.sessionStorage.getItem(BUFFER_KEY) : null;
      if (raw) { state.queue = JSON.parse(raw) || []; }
    } catch (e) { /* noop */ }
  }

  function clearBuffer() {
    try { if (global.sessionStorage) { global.sessionStorage.removeItem(BUFFER_KEY); } } catch (e) { /* noop */ }
  }

  // ---------- 自动字段填充（auto: true 字段由 SDK 填充，前端无需传） ----------

  function autoFields() {
    var path = global.location ? global.location.pathname : '/';
    return {
      page_path: normalizePagePath(path),
      referrer_host: normalizeReferrerHost(document.referrer),
      device_type: detectDeviceType(navigator.userAgent)
    };
  }

  function applyAutoFields(event) {
    // 信封只能位于批量体顶层，避免调用方误传到事件行。
    delete event.sess_ref;
    delete event.page_path;
    delete event.referrer_host;
    delete event.device_type;
    // event_id 幂等键（2026-11-12）：SDK 生成、重试不换号，服务端跨请求去重；缺失时服务端兜底注入
    if (event.event_id === undefined) {
      event.event_id = newEventId();
    }
    return event;
  }

  /** event_id：16 hex 随机（ crypto.getRandomValues 优先，降级 Math.random） */
  function newEventId() {
    try {
      var buf = new Uint8Array(8);
      (global.crypto || global.msCrypto).getRandomValues(buf);
      var hex = '';
      for (var i = 0; i < buf.length; i++) { hex += ('0' + buf[i].toString(16)).slice(-2); }
      return hex;
    } catch (e) {
      var s = '';
      for (var j = 0; j < 16; j++) { s += '0123456789abcdef'.charAt(Math.floor(Math.random() * 16)); }
      return s;
    }
  }

  // ---------- manifest（加载失败 console.warn 不阻断上报） ----------

  function loadManifest(url) {
    if (!url) { return; }
    try {
      var xhr = new XMLHttpRequest();
      xhr.open('GET', url, true);
      xhr.onreadystatechange = function () {
        if (xhr.readyState !== 4) { return; }
        if (xhr.status >= 200 && xhr.status < 300) {
          try {
            state.manifest = JSON.parse(xhr.responseText);
          } catch (e) {
            if (isDebug()) { console.warn('[telemetry] manifest JSON 解析失败，按无 manifest 继续', e); }
          }
        } else {
          if (isDebug()) { console.warn('[telemetry] manifest 加载失败（不阻断上报，后端是权威清洗方）', xhr.status); }
        }
      };
      xhr.send(null);
    } catch (e) {
      if (isDebug()) { console.warn('[telemetry] manifest 加载异常（不阻断上报）', e); }
    }
  }

  // ---------- 批量与发送 ----------

  function eventBytes(e) {
    try { return JSON.stringify(e).length; } catch (err) { return MAX_SINGLE_EVENT_BYTES + 1; }
  }

  function enqueue(event) {
    var size = eventBytes(event);
    if (size > MAX_SINGLE_EVENT_BYTES) {
      // 单事件超 32KB：单独发送 + console.warn（不混入批）
      if (isDebug()) { console.warn('[telemetry] 单事件超 32KB，单独发送', event.event, size); }
      if (state.consentMode === 'granted') { sendBatch([event], 0, true); }
      return;
    }
    state.queue.push(event);
    while (state.queue.length > MAX_QUEUE) {
      state.queue.shift();
      state.droppedCount++;
      if (isDebug()) { console.warn('[telemetry] 队列超 200，丢弃最旧事件（累计 ' + state.droppedCount + '）'); }
    }
    persistBuffer();
    scheduleFlush();
  }

  var flushScheduled = false;
  /** 同 tick 合并：同一事件循环内的多次 track 攒成一批（setTimeout 0 让出执行栈后再拆批发送） */
  function scheduleFlush() {
    if (flushScheduled) { return; }
    flushScheduled = true;
    setTimeout(function () {
      flushScheduled = false;
      flush();
    }, 0);
  }

  /** 按 50 条或 32KB 取小值拆批 */
  function splitBatches() {
    var batches = [];
    var cur = [];
    var curBytes = 0;
    for (var i = 0; i < state.queue.length; i++) {
      var e = state.queue[i];
      var b = eventBytes(e);
      if (cur.length > 0 && (cur.length + 1 > MAX_BATCH_EVENTS || curBytes + b > MAX_BATCH_BYTES)) {
        batches.push(cur);
        cur = [];
        curBytes = 0;
      }
      cur.push(e);
      curBytes += b;
    }
    if (cur.length > 0) { batches.push(cur); }
    state.queue = [];
    return batches;
  }

  function flushDenied() {
    var rows = [];
    var counts = state.deniedCounts;
    state.deniedCounts = {};
    for (var name in counts) {
      if (counts.hasOwnProperty(name) && counts[name] > 0) {
        rows.push({ event: name, total: counts[name] });
      }
    }
    if (rows.length > 0) { sendBatch(rows, 0, false); }
  }

  function flush() {
    flushDenied(); // consent 随批次固定，重试或稍后切换状态也不会变成 granted 明细
    if (state.consentMode !== 'granted') { return; } // unset=缓冲待回放；denied=只发匿名聚合计数
    if (state.sending || state.queue.length === 0) { return; }
    var batches = splitBatches();
    clearBuffer();
    for (var i = 0; i < batches.length; i++) {
      sendBatch(batches[i], 0, true);
    }
  }

  /** 决策事实事件：最小行 {event, consent} 即时单批发送（服务端剥离为 {event, consent, ts}，不注 anon_id） */
  function sendDecision(name) {
    var isGranted = state.consent === true;
    sendBatch([{ event: name, consent: isGranted }], 0, isGranted);
  }

  function payloadFor(batch, consent) {
    var body = {
      site_id: state.siteId,
      consent: consent === true,
      events: batch
    };
    if (body.consent) {
      var auto = autoFields();
      body.sess_ref = getSessRef(state.siteId);
      body.page_path = auto.page_path;
      body.device_type = auto.device_type;
      body.referrer_host = auto.referrer_host;
    }
    return JSON.stringify(body);
  }

  function sendBatch(batch, attempt, consent) {
    // 存量生产域保持兼容；新站由 init.production 显式启用；localhost/127.0.0.1 仅用于同源联调。
    var host = '';
    try { host = global.location.hostname || ''; } catch (e) { }
    var prodHost = state.production || /(^|\.)(lasazhaopin|guomeijiayu)\.com$/i.test(host);
    var localHost = host === 'localhost' || host === '127.0.0.1';
    if (!prodHost && !localHost) {
      if (isDebug()) { console.debug('[telemetry] 非生产域名，遥测隔离生效，跳过上报（' + host + '）'); }
      return;
    }
    var body = payloadFor(batch, consent);
    var sent = false;
    try {
      if (navigator.sendBeacon) {
        // text/plain：与后端契约一致（PHP 不填充 $_POST，走 php://input）
        sent = navigator.sendBeacon(state.endpoint, new Blob([body], { type: 'text/plain;charset=UTF-8' }));
      }
    } catch (e) { sent = false; }
    if (sent) { return; }

    // fetch keepalive 兜底；失败重试指数退避 ≤3 次，超限丢弃并计数
    var doFetch = function () {
      fetch(state.endpoint, {
        method: 'POST',
        body: body,
        keepalive: true,
        headers: { 'Content-Type': 'text/plain;charset=UTF-8' }
      }).then(function () { /* 204：成功 */ })
        .catch(function () { retryOrDrop(batch, attempt, consent); });
    };
    try { doFetch(); } catch (e) { retryOrDrop(batch, attempt, consent); }
  }

  function retryOrDrop(batch, attempt, consent) {
    if (attempt < MAX_RETRIES) {
      var delay = Math.round(100 * Math.pow(4, attempt)); // 100ms/400ms/1600ms
      setTimeout(function () { sendBatch(batch, attempt + 1, consent); }, delay);
      state.retryCount++;
    } else {
      state.oversizeCount++;
      if (isDebug()) { console.warn('[telemetry] 发送失败，重试超限丢弃（累计 ' + state.oversizeCount + '）'); }
    }
  }

  // ---------- page_view 自动上报（load + SPA history，v5 §3.8 要素 1） ----------

  function sendPageView() {
    var path = normalizePagePath(global.location ? global.location.pathname : '/');
    if (path === state.lastPagePath) { return; } // 同路径去重（hash 变化不重复计 pv）
    state.lastPagePath = path;
    Telemetry.track('page_view', {});
  }

  function setupAutoPageView() {
    // load：首屏
    if (document.readyState === 'complete') {
      setTimeout(sendPageView, 0);
    } else {
      global.addEventListener('load', sendPageView);
    }
    // SPA：包装 pushState/replaceState + popstate
    var wrap = function (name) {
      var orig = history[name];
      if (typeof orig !== 'function') { return; }
      history[name] = function () {
        var ret = orig.apply(this, arguments);
        try { sendPageView(); } catch (e) { /* 埋点永不报错 */ }
        return ret;
      };
    };
    try {
      wrap('pushState');
      wrap('replaceState');
      global.addEventListener('popstate', sendPageView);
    } catch (e) { /* SSR/受限环境：退化为仅 load 上报 */ }
  }

  // ---------- 公开 API ----------

  var Telemetry = {
    /** 初始化；endpoint 必须完整 URL（含 origin），SDK 不拼接任何前缀 */
    init: function (opts) {
      opts = opts || {};
      if (!opts.siteId || !opts.endpoint) {
        if (isDebug()) { console.assert(false, '[telemetry] init 缺 siteId/endpoint'); }
        return;
      }
      state.siteId = String(opts.siteId);
      state.endpoint = String(opts.endpoint); // 完整 URL，原样使用
      state.production = opts.production === true;
      state.consent = opts.consent === true;
      state.consentMode = opts.consentMode === 'granted' || opts.consentMode === 'denied'
        ? opts.consentMode
        : (opts.consent === true ? 'granted' : 'unset');
      if (state.consentMode === 'unset') { restoreBuffer(); }
      state.inited = true;
      if (opts.manifestUrl) { loadManifest(String(opts.manifestUrl)); }
      setupAutoPageView();
      if (isDebug()) { console.info('[telemetry] init ok', state.siteId); }
    },

    /**
     * 唯一手动上报 API。信封字段由 SDK 放到 granted 批量体顶层；
     * 业务字段缺失时开发期 console.warn，生产静默上报（后端清洗）。
     */
    track: function (event, payload) {
      if (!state.inited || !event || typeof event !== 'string') { return; }
      // 决策事实事件：恒最小行即时发送（先于三态门控）
      if (DECISION_EVENTS[event]) {
        sendDecision(event);
        return;
      }
      // denied：不构造业务明细，只按事件名累计并发送 {event,total} 匿名聚合行
      if (state.consentMode === 'denied') {
        state.deniedCounts[event] = (state.deniedCounts[event] || 0) + 1;
        scheduleFlush();
        return;
      }
      var e = { event: event };
      payload = payload || {};
      for (var k in payload) {
        if (payload.hasOwnProperty(k)) { e[k] = payload[k]; }
      }
      applyAutoFields(e);

      if (isDebug() && state.manifest && state.manifest.events) {
        // 开发期：仅 console.assert 开发者反馈，不阻断发送（生产不校验，v5 P1-4）
        var def = state.manifest.events[event];
        console.assert(!!def, '[telemetry] 事件未在 manifest 注册: ' + event);
        if (def && def.required_fields) {
          for (var i = 0; i < def.required_fields.length; i++) {
            var f = def.required_fields[i];
            var isAuto = def.auto_fields && def.auto_fields.indexOf(f) !== -1;
            console.assert(isAuto || e[f] !== undefined, '[telemetry] 事件 ' + event + ' 缺必填字段: ' + f);
          }
        }
      }
      enqueue(e);
    },

    /** 三态门控切换：granted=回放未决策缓冲；denied=清空明细缓冲、只发匿名聚合计数 */
    setConsent: function (value) {
      var granted = value === true;
      state.consent = granted;
      state.consentMode = granted ? 'granted' : 'denied';
      if (granted) {
        if (state.inited) { flush(); } // A1 回放
      } else {
        state.droppedCount += state.queue.length;
        state.queue = [];
        clearBuffer();
      }
    },

    /** 手动补发 page_view（异常场景兜底；正常情况 SDK 自动上报） */
    pageView: function () {
      state.lastPagePath = null; // 允许同路径补发
      sendPageView();
    },

    /** 诊断信息（开发期排查用，非上报接口） */
    _diag: function () {
      return {
        siteId: state.siteId,
        sessRef: state.siteId ? getSessRef(state.siteId) : '',
        queue: state.queue.length,
        droppedCount: state.droppedCount,
        oversizeCount: state.oversizeCount,
        retryCount: state.retryCount,
        manifestLoaded: !!state.manifest,
        consent: state.consent,
        consentMode: state.consentMode
      };
    }
  };

  global.Telemetry = Telemetry;
})(typeof window !== 'undefined' ? window : this);
