---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RULES_VERSION_LABEL } from '../lib/site';

const title = 'Page not found — DQF Expiration Tracker';
const description =
  'That page does not exist. Open the DQF Expiration Tracker, privacy policy, or terms of service.';
---

<BaseLayout title={title} description={description} path="/404.html" noindex dataPage="page">
  <div class="container not-found">
    <p class="eyebrow">404 · File not found</p>
    <h1>That page is not in this folder</h1>
    <p>The address may be mistyped, or the page may have moved. These links are available:</p>
    <ul class="not-found-links">
      <li><a href="/">DQF Expiration Tracker</a></li>
      <li><a href="/privacy/">Privacy policy</a></li>
      <li><a href="/terms/">Terms of service</a></li>
    </ul>
    <p class="note">{RULES_VERSION_LABEL}</p>
  </div>
</BaseLayout>

<style>
  .not-found {
    max-width: 720px;
    padding-block: var(--space-8);
  }

  .not-found h1 {
    font-size: clamp(28px, 5vw, var(--text-2xl));
  }

  .not-found p {
    max-width: 60ch;
    color: var(--ink-muted);
  }

  .not-found-links {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-5) 0;
    padding: 0;
    list-style: none;
  }

  .not-found-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
</style>
