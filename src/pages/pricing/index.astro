---
import LegalLayout from '../../layouts/LegalLayout.astro';

const path = '/pricing';
const title = 'Pricing — DQF Expiration Tracker';
const description = 'Pro plan pricing for the DQF Expiration Tracker: what the Pro plan will include and when checkout opens.';

import { CANONICAL_ORIGIN } from '../../lib/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: CANONICAL_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Pricing', item: CANONICAL_ORIGIN + '/pricing' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Pricing — DQF Expiration Tracker',
    url: CANONICAL_ORIGIN + '/pricing',
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'DQF Expiration Tracker', url: CANONICAL_ORIGIN + '/' },
  },
];
---

<LegalLayout title={title} description={description} path={path} updated="2026-11-26" jsonLd={jsonLd}>
  <h2>Pro</h2>
  <p>Pro is coming soon.</p>
  <p>
    We are building a Pro plan with additional features. Pricing and plan details will be published
    on this page when the plan launches.
  </p>
</LegalLayout>
