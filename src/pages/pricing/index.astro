---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CANONICAL_ORIGIN } from '../../lib/site';

const path = '/pricing';
const title = 'Pricing — DQF Expiration Tracker';
const description =
  'Everything on the DQF Expiration Tracker is free right now — no daily limit and no card required.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: CANONICAL_ORIGIN + '/' },
      { '@type': 'ListItem', position: 2, name: 'Pricing', item: CANONICAL_ORIGIN + '/pricing' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Pricing — DQF Expiration Tracker',
    url: CANONICAL_ORIGIN + '/pricing',
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'DQF Expiration Tracker', url: CANONICAL_ORIGIN + '/' },
  },
];
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd} dataPage="pricing">
  <section class="section">
    <div class="container pricing-main">
      <h1 class="pricing-title">Pricing</h1>

      <section id="pricing-free-note">
        <p>Everything on this site is free right now — no daily limit, no card required.</p>
        <p>There is no paid tier today. When Pro launches, prices will be published on this page.</p>
      </section>

      <!-- Paid skeleton stays in the DOM but hidden until pricing.sellable === true. -->
      <div id="pricing-plans" class="pricing-grid" hidden></div>
      <p class="pricing-testmode" id="pricing-testmode" hidden>Test mode — no real charge.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .pricing-main {
    max-width: 760px;
  }
</style>
