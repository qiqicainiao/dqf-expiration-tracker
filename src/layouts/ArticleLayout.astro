---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow?: string;
  published?: string;
}

const { title, description, path, eyebrow = 'Guide', published = '2026-11-13' } = Astro.props;
---

<BaseLayout title={title} description={description} path={path}>
  <article class="article">
    <div class="container article-inner">
      <header class="article-header">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="article-lede">{description}</p>
        <p class="article-meta">Published {published} · Estimated reading time: 7 minutes</p>
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: var(--space-7);
  }

  .article-inner {
    max-width: 820px;
  }

  .article-header {
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-5);
    border-bottom: 2px solid var(--ink);
  }

  .article-lede {
    max-width: 68ch;
    color: var(--ink-muted);
    font-size: var(--text-lg);
  }

  .article-meta {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  .prose :global(h2) {
    margin-top: var(--space-6);
  }

  .prose :global(h3) {
    margin-top: var(--space-5);
  }

  .prose :global(p),
  .prose :global(li) {
    max-width: 74ch;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-5);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  .prose :global(callout) {
    display: block;
  }
</style>
