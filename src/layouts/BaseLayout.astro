---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/tool.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ConsentBanner from '../components/site/ConsentBannerBox.astro';
import { CANONICAL_ORIGIN } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  dataPage?: string;
}

const { title, description, path, noindex = false, jsonLd = [], dataPage = 'page' } = Astro.props;
const canonical = `${CANONICAL_ORIGIN}${path}`;
const ogTitle = title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : <meta name="robots" content="index,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DQF Expiration Tracker" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${CANONICAL_ORIGIN}/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${CANONICAL_ORIGIN}/og-image.png`} />
    <meta name="theme-color" content="#f6f1e7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/_site_config.js?v=1.1.1"></script>
    <script src="/bff/js/vr-dqf-tracker.js?v=3.0.0" data-vr-site="dqf-tracker" defer></script>
    {jsonLd.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body data-page={dataPage}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <SiteHeader path={path} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <ConsentBanner />

    <!-- Account UI: markup lives here so every page gets it from one place. -->
    <div id="toast" class="toast" role="status" aria-live="polite"></div>
    <div class="modal-backdrop" id="auth-modal" hidden>
      <div class="modal" role="dialog" aria-modal="true" aria-labelledby="auth-title">
        <button type="button" class="modal-close" id="auth-close" aria-label="Close">×</button>
        <h3 id="auth-title">Sign in</h3>
        <p class="modal-sub" id="auth-sub">Your checks and plan are tied to this account.</p>
        <form id="auth-form" novalidate>
          <label for="auth-email">Email</label>
          <input type="email" id="auth-email" name="email" required autocomplete="email" placeholder="you@company.com" />
          <label for="auth-password">Password</label>
          <input type="password" id="auth-password" name="password" required minlength="8" autocomplete="current-password" placeholder="At least 8 characters" />
          <p class="auth-error" id="auth-error" role="alert" hidden></p>
          <button type="submit" class="btn" id="auth-submit">Sign in</button>
        </form>
        <p class="modal-switch"><button type="button" class="link-btn" id="auth-switch">New here? Create an account</button></p>
      </div>
    </div>

    <!-- Same-origin external script: allowed by script-src 'self', no inline hash needed. -->
    <script is:inline src="/assets/js/account.js?v=3.4.0" data-account-site="dqf-tracker"></script>
  </body>
</html>
