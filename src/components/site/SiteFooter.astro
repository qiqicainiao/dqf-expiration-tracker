---
import { DISCLAIMER_SENTENCE, RULES_VERSION_LABEL, siteConfig } from '../../lib/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-about">
      <p class="footer-brand">DQF Expiration Tracker</p>
      <p class="footer-copy">
        A free date tracker for owner-operators and small fleets. Driver data stays in your browser.
      </p>
      <p class="footer-copy">{DISCLAIMER_SENTENCE}</p>
    </div>
    <nav aria-label="Footer">
      <ul class="footer-links">
        <li><a href="/">Tracker</a></li>
        <li><a href="/blog/how-to-build-your-first-dqf/">How to build your first DQF</a></li>
        <li><a href="/privacy/">Privacy policy</a></li>
        <li><a href="/terms/">Terms of service</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/refund">Refund policy</a></li>
        <li><a href="/account">Your account</a></li>
        <li><a href="#" id="dqf-consent-settings">Cookie settings</a></li>
        <li><a href="/llms.txt">llms.txt</a></li>
      </ul>
    </nav>
  </div>
  <div class="container footer-meta">
    <span>{RULES_VERSION_LABEL}</span>
    <span aria-hidden="true">·</span>
    {/* Machine-readable "page last updated" (<time datetime>) is required by crawlers.
        Before 2026-11-19 this was plain text "Last rule update", scored date:missing. */}
    <span>Page last updated <time datetime="2026-11-19">19 Nov 2026</time></span>
    <span aria-hidden="true">·</span>
    <span>Version {siteConfig.VERSION}</span>
    <span aria-hidden="true">·</span>
    <span>Based on FMCSA Part 391</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    padding-block: var(--space-6) var(--space-5);
    color: var(--paper-raised);
    background: var(--ink);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-6);
  }

  .footer-brand {
    margin-bottom: var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .footer-copy {
    margin-bottom: var(--space-2);
    color: var(--manila);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .footer-links {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--paper-raised);
    font-size: var(--text-sm);
    text-underline-offset: 3px;
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    color: var(--manila);
    border-top: 1px solid var(--ink-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
