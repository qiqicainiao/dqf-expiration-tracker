---
import { RULES_VERSION_LABEL } from '../../lib/site';
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Free · No account · 1–5 drivers</p>
      <h1>DQF Expiration Tracker</h1>
      <p class="lede">
        Know your next estimated DQF expiration date before it becomes a problem. Enter the dates
        you already have and see what is overdue, what is due in 30 or 60 days, and what is still
        on file.
      </p>
      <p class="hero-actions">
        <a class="btn" href="#tracker" data-cta-source="hero_cta">Start tracking</a>
        <a class="btn btn--ghost" href="#how-it-works">See how it works</a>
      </p>
      <p class="privacy-line">
        Your driver data stays in this browser. No account, no upload.
      </p>
    </div>
    <aside class="hero-sheet" aria-label="What the tracker covers">
      <p class="sheet-tab">DQF folder · index</p>
      <ul>
        <li>Medical examiner's certificate</li>
        <li>MVR pull</li>
        <li>CDL expiration</li>
        <li>Annual review</li>
        <li>Road test</li>
        <li>Employment verification</li>
      </ul>
      <p class="sheet-foot">{RULES_VERSION_LABEL}</p>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  .lede {
    max-width: 62ch;
    color: var(--ink-muted);
    font-size: var(--text-lg);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block: var(--space-5) var(--space-3);
  }

  .privacy-line {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .hero-sheet {
    position: relative;
    margin-top: var(--space-5);
    padding: var(--space-5);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-top: 6px solid var(--manila);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-card);
    transform: rotate(0.4deg);
  }

  .sheet-tab {
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    color: var(--ink-muted);
    border-bottom: 1px dashed var(--line);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-sheet ul {
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding-left: var(--space-4);
    font-size: var(--text-sm);
  }

  .sheet-foot {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-sheet {
      transform: none;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding-block: var(--space-6) var(--space-5);
    }

    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
