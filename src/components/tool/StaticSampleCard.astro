---
const rows = [
  { doc: "Medical examiner's certificate", due: 'Mar 14, 2027', status: 'ok', statusText: 'ON TRACK', citation: '49 CFR 391.45(b)' },
  { doc: 'MVR pull', due: 'Nov 1, 2026', status: 'overdue', statusText: 'OVERDUE', citation: '49 CFR 391.25(c)(2)' },
  { doc: 'CDL expiration', due: 'Dec 1, 2026', status: 'due_30', statusText: 'DUE 30', citation: '49 CFR Part 383' },
  { doc: 'Annual review', due: 'Dec 30, 2026', status: 'due_60', statusText: 'DUE 60', citation: '49 CFR 391.25(a)' },
];
---

<section class="sample-section" aria-labelledby="sample-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Example output</p>
      <h2 id="sample-title">What a result card looks like</h2>
      <p class="note">
        Sample dates only. Your own results are calculated from the dates you enter and your
        device date.
      </p>
    </div>

    <div class="sample-card">
      <div class="sample-head">
        <div>
          <p class="sample-label">Driver 1 · CDL holder</p>
          <p class="sample-next-label">Next estimated due date</p>
          <p class="sample-next-date">Nov 1, 2026</p>
          <p class="sample-next-doc">Motor vehicle record (MVR)</p>
        </div>
        <span class="stamp stamp--overdue">
          <span class="stamp-icon" aria-hidden="true">!</span>
          OVERDUE
        </span>
      </div>

      <ul class="sample-list">
        {rows.map((row) => (
          <li class="sample-row">
            <div class="sample-row-main">
              <span class="sample-doc">{row.doc}</span>
              <span class="sample-date">{row.due}</span>
            </div>
            <div class="sample-row-meta">
              <span class={`stamp stamp--${row.status}`}>
                <span class="stamp-icon" aria-hidden="true">{row.status === 'ok' ? '✓' : '▲'}</span>
                {row.statusText}
              </span>
              <span class="citation">{row.citation}</span>
            </div>
          </li>
        ))}
      </ul>

      <p class="sample-foot">
        Estimated based on FMCSA Part 391. Not legal advice. Example output is static and does not
        use your data.
      </p>
    </div>
  </div>
</section>

<style>
  .sample-section {
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--line);
  }

  .section-head {
    max-width: 68ch;
    margin-bottom: var(--space-5);
  }

  .sample-card {
    padding: var(--space-5);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }

  .sample-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 2px solid var(--ink);
  }

  .sample-label,
  .sample-next-label,
  .sample-next-doc {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .sample-next-label {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .sample-next-date {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(32px, 5vw, var(--text-3xl));
    font-weight: 700;
    line-height: 1.1;
  }

  .sample-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sample-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px dashed var(--line);
  }

  .sample-row-main {
    display: grid;
    gap: 2px;
    min-width: 180px;
  }

  .sample-doc {
    font-weight: 600;
  }

  .sample-date {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .sample-row-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .citation {
    color: var(--ink-muted);
    font-size: var(--text-xs);
  }

  .stamp {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    color: var(--ink);
    background: var(--paper-raised);
    border: 2px solid var(--ink-muted);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .stamp-icon {
    font-size: 13px;
    line-height: 1;
  }

  .stamp--overdue {
    border-color: var(--stamp-red);
  }

  .stamp--overdue .stamp-icon {
    color: var(--stamp-red);
  }

  .stamp--due_30 {
    border-color: var(--amber);
  }

  .stamp--due_30 .stamp-icon {
    color: var(--amber);
  }

  .stamp--due_60 {
    border-color: var(--manila-deep);
  }

  .stamp--due_60 .stamp-icon {
    color: var(--manila-deep);
  }

  .stamp--ok {
    border-color: var(--green);
  }

  .stamp--ok .stamp-icon {
    color: var(--green);
  }

  .sample-foot {
    margin: var(--space-4) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 480px) {
    .sample-card {
      padding: var(--space-4);
    }

    .sample-row {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
